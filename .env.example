NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Identifiants de la base. docker-compose.yml les lit dans ce même fichier.
POSTGRES_USER=<utilisateur>
POSTGRES_PASSWORD=<mot_de_passe>
POSTGRES_DB=<nom_de_la_base>

# Doit correspondre aux identifiants ci-dessus et au service `db` de docker-compose.yml
DATABASE_URL=postgresql://<utilisateur>:<mot_de_passe>@localhost:5432/<nom_de_la_base>
DB_POOL_MAX=10
