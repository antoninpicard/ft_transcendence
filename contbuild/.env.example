# Fichier unique pour tout le projet : copiez-le en contbuild/.env.
# Le compose de l'équipe (make) le lit pour ses trois services, et les scripts npm
# de l'API (npm run dev, migrate, test:db) le lisent aussi.

NODE_ENV=development
# Port de l'API quand elle tourne en local avec npm run dev. Dans le compose, chaque
# service fixe son propre port : app (le site) sur 3000, api sur 3001.
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Identifiants de la base. Le service db du compose les lit dans ce même fichier.
POSTGRES_USER=<utilisateur>
POSTGRES_PASSWORD=<mot_de_passe>
POSTGRES_DB=<nom_de_la_base>

# Pour npm run dev en local : la base publiée sur localhost. Dans le compose, le service
# api remplace cette valeur pour viser le service db.
DATABASE_URL=postgresql://<utilisateur>:<mot_de_passe>@localhost:5432/<nom_de_la_base>
DB_POOL_MAX=10

# Connexion avec 42 (optionnel : vide, /api/auth/42 répond 503)
# Valeurs de l'application créée sur l'intra ; FORTYTWO_REDIRECT_URI vaut par exemple
# http://localhost:3000/api/auth/42/callback et doit être celle enregistrée sur l'intra.
# FRONT_URL est l'adresse du site, où l'API renvoie après la connexion 42.
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_REDIRECT_URI=
FORTYTWO_API_URL=https://api.intra.42.fr
FRONT_URL=http://localhost:3000

# Badgeuse NFC (optionnel : vide, les routes /api/badge, /api/hello et /api/scan répondent 503)
# Générer chaque secret avec : openssl rand -hex 32
# DEVICE_TOKEN doit être identique à celui du pont USB de la borne (webapp/badge-bridge/.env).
# BADGE_UID_SECRET doit faire au moins 32 caractères.
DEVICE_TOKEN=
BADGE_UID_SECRET=
# Adresses IP de la borne, seules autorisées à se connecter par badge, séparées par des
# virgules (ex. 10.11.12.13). Vide : la connexion par badge répond 503.
BADGE_LOGIN_ALLOWED_IPS=
