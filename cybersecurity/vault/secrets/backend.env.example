# Secrets of the API (webapp/backend), loaded into Vault at secret/backend/app by
# scripts/bootstrap.sh. One KEY=value per line, no quotes. An empty value turns the
# feature off (the API answers 503 on its routes).
# In the integrated stack, leave these keys empty in contbuild/.env: they are ignored there.

# Badge reader: must be the same token as in app.env and in the ESP32 firmware
DEVICE_TOKEN=
# At least 32 characters: openssl rand -hex 32
BADGE_UID_SECRET=
# 42 OAuth application secret (FORTYTWO_CLIENT_ID stays in contbuild/.env: it is not secret)
FORTYTWO_CLIENT_SECRET=
