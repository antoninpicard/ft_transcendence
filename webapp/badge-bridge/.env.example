# Copy this file to .env (ignored by Git) on the kiosk PC, next to the badge reader.

# Serial port of the ESP32, as shown by the Arduino IDE: COM3 (Windows),
# /dev/ttyUSB0 (Linux) or /dev/cu.usbserial-XXXX (macOS)
SERIAL_PORT=
# Address of the site: https://localhost:8443 when the kiosk PC is the machine running make
API_URL=
# Only needed when the bridge runs without make: make (bridge.sh) takes DEVICE_TOKEN from
# cybersecurity/vault/secrets/backend.env, the file it loads into Vault for the API
DEVICE_TOKEN=

# make starts the bridge (bridge.sh). HTTPS with the self-signed certificate of the WAF:
# bridge.sh gives Node the certificate to trust it, instead of turning certificate checks
# off. By hand: NODE_EXTRA_CA_CERTS=../../cybersecurity/waf/certs/server.crt npm start
# The certificate is only valid for localhost and 127.0.0.1.
