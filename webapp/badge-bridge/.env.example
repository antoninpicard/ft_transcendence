# Copy this file to .env (ignored by Git) on the kiosk PC, next to the badge reader.

# Serial port of the ESP32: COM3 (Windows) or /dev/ttyUSB0 (Linux); the Arduino IDE shows it
SERIAL_PORT=
# Address of the site: https://localhost:8443 behind the WAF (http://localhost:3000 without it)
API_URL=
# Same value as DEVICE_TOKEN in contbuild/.env
DEVICE_TOKEN=

# HTTPS with the self-signed certificate of the WAF: give Node the certificate to trust it,
# instead of turning certificate checks off, by starting the bridge with
#   NODE_EXTRA_CA_CERTS=../../cybersecurity/waf/certs/server.crt npm start
